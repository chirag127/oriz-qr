---
import Base from '../layouts/Base.astro'
import Studio from '../components/Studio.tsx'

// deterministic op-art mosaic pattern (9x6) — a static QR-like reveal
const cells = Array.from({ length: 54 }, (_, i) => {
  const on = (i * 7 + ((i / 9) | 0) * 3) % 5 === 0
  const off = (i * 3) % 7 === 0
  return { on, off, delay: (i % 9) * 40 + ((i / 9) | 0) * 30 }
})
---

<Base>
  <section class="hero">
    <span class="hero__kicker">client-side qr studio</span>
    <h1 class="hero__title">Free QR Code <em>Generator</em> &amp; Scanner</h1>
    <p class="hero__sub">
      Make QR codes for links, Wi-Fi, contacts, UPI, email &amp; SMS — then scan any code with your camera.
      No upload, no signup, nothing leaves your device.
    </p>
    <div class="mosaic" aria-hidden="true">
      {cells.map((c) => (
        <i
          class:list={[c.on && 'on', c.off && 'off']}
          style={`animation-delay:${c.delay}ms`}
        />
      ))}
    </div>
  </section>

  <Studio client:load />

  <div class="feats">
    <div class="feat"><b>Restyle</b><br />any ink + paper color, logo overlay, error-correction</div>
    <div class="feat"><b>Scan on-device</b><br />live camera or drop an image — decoded locally</div>
    <div class="feat"><b>Private &amp; free</b><br />no upload, no signup, no tracking</div>
  </div>
</Base>
