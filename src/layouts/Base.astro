---
import '@chirag127/oz-tokens-base'
import '@chirag127/oz-chrome/styles.css'
import '@fontsource-variable/space-grotesk'
import '@fontsource-variable/jetbrains-mono'
import '../styles/theme.css'
import OzToolShell from '@chirag127/oz-chrome/components/OzToolShell.astro'
import { pwaInfo } from 'virtual:pwa-info'

interface Props {
  title?: string
  description?: string
}
const {
  title = 'QR Code Generator & Scanner — free, no signup | oriz QR',
  description = 'Free online QR code generator & scanner — make QR codes for URLs, Wi-Fi, contacts, UPI, email & SMS with custom colors and a logo, then scan any code with your camera. 100% in your browser, no upload, no signup.',
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://qr.oriz.in').href
const ogImage = new URL('/screenshots/desktop.png', Astro.site ?? 'https://qr.oriz.in').href
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'oriz QR',
  description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  url: 'https://qr.oriz.in',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="theme-color" content="#c6ff00" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="oriz QR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <script is:inline src="/registerSW.js"></script>
  </head>
  <body>
    <OzToolShell site="qr" title="QR studio">
      <a slot="nav" class="mono" href="https://github.com/chirag127/oriz-qr" style="font-size:.8rem;letter-spacing:.08em">GITHUB</a>
      <slot />
    </OzToolShell>
  </body>
</html>
